<?xml version="1.0" encoding="utf-8"?>
<!--
    Данные приложения не переносятся: сохранённая очередь и позиция привязаны к устройству
    (идентификаторы MediaStore, content:// обложек), флаг запроса уведомлений — к установке.
    Облачный бэкап выключен allowBackup="false"; на API 31+ перенос между устройствами от него
    не зависит, поэтому исключён здесь. Кэши (cacheDir, no_backup) система не переносит сама.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
